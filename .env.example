# Salin ke .env lalu isi. Jangan pernah commit .env.

# WAJIB di produksi (minimal 16 karakter acak): dipakai untuk sesi masuk DAN tanda buku jejak.
# Mengganti nilai ini membuat tanda buku jejak lama tidak bisa diverifikasi lagi.
SESSION_SECRET=

# Daftar email (pisahkan koma) yang otomatis menjadi admin saat mendaftar.
ADMIN_EMAILS=

PORT=3000
# Lokasi basis data + unggahan. Di Docker: /data (volume).
# DATA_DIR=./data
# Isi 1 bila disajikan lewat HTTPS agar cookie bertanda Secure.
SECURE_COOKIES=0

# ---- Opsional ----
# Usulan segmen teks lewat Claude API (tanpa kunci: fitur nonaktif; langganan Claude Pro BUKAN kunci API).
# ANTHROPIC_API_KEY=
# AI_MODEL=
# Pengenal ujaran milik operator sendiri (daftar argumen JSON; berkas audio ditambahkan di akhir).
# Hasilnya hanya DRAF yang wajib diperiksa maestro. se-LARAS tidak membawa/melatih model ASR Suroboyoan.
# ASR_COMMAND_JSON=["python3","/opt/asr/transkripsi.py"]
# Batas percobaan masuk per jendela waktu (bawaan 10).
# AUTH_LIMIT=10
# HANYA untuk demo lokal: tampilkan tombol masuk akun contoh (setelah `npm run seed`). Jangan di produksi.
# LARAS_DEMO=1
# PYTHON=python3
# FFMPEG=ffmpeg
# FFPROBE=ffprobe
